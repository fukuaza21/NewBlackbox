<?xml version="1.0" encoding="utf-8"?>
<!-- App-wide window background: deep-space vertical wash. Single static gradient,
     drawn once by the window — no per-view cost. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="rectangle">
    <gradient
            android:angle="270"
            android:startColor="#141428"
            android:centerColor="#0F0F1A"
            android:endColor="#0A0A14"
            android:type="linear" />
</shape>
